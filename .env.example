# Copy to .env and fill in ONE key. Without a key the app still runs in engine-only mode
# (full Stockfish analysis + a deterministic report; chat is disabled).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto              # auto | anthropic | openai | none
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5-mini
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# ENGINE_DEPTH=12                 # fast pass over every position
# ENGINE_DEEP_NODES=300000        # nodes per critical moment (multi-PV re-check)
# ENGINE_WORKERS=4                # parallel Stockfish processes
# COACH_OFFLINE=1                 # never call Chess.com; serve fixtures only
# PORT=8000
